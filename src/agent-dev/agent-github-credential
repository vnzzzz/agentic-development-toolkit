#!/usr/bin/env bash
set -Eeuo pipefail

# shellcheck source=/dev/null
source /usr/local/lib/agent-dev/github-auth-lib.sh

operation=${1:-}
profile=${AGENT_GITHUB_PROFILE:-}
[[ -n $profile ]] || agent_github_die 'AGENT_GITHUB_PROFILE is not set'

protocol=
host=
path=
password=
while IFS='=' read -r key value; do
  [[ -n $key ]] || break
  case "$key" in
    protocol) protocol=$value ;;
    host) host=$value ;;
    path) path=$value ;;
    password) password=$value ;;
  esac
done

case "$operation" in
  get)
    [[ $protocol == https && $host == github.com ]] || exit 0
    agent_github_current_repo
    if [[ -n $path ]]; then
      normalized_path=${path%.git}
      [[ $normalized_path == "$AGENT_GITHUB_REPO_FULL_NAME" ]] || exit 0
    fi
    token=$(agent_github_mint_token "$profile")
    printf 'username=x-access-token\npassword=%s\n\n' "$token"
    ;;
  store|erase)
    if [[ -n $password ]]; then
      agent_github_revoke_token "$password" >/dev/null 2>&1 || true
    fi
    ;;
  *)
    agent_github_die "unsupported git credential operation: ${operation:-<empty>}"
    ;;
esac
