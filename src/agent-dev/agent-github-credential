#!/usr/bin/env bash
set -Eeuo pipefail

# shellcheck source=/dev/null
source /usr/local/lib/agent-dev/github-auth-lib.sh

operation=${1:-}
profile=${AGENT_GITHUB_PROFILE:-}
[[ -n $profile ]] || agent_github_die 'AGENT_GITHUB_PROFILE is not set'
repository=${AGENT_GITHUB_REPOSITORY:-}
[[ -n $repository ]] || agent_github_die 'AGENT_GITHUB_REPOSITORY is not set in authenticated GitHub App session'
agent_github_set_repo_full_name "$repository"

protocol=
host=
path=
while IFS='=' read -r key value; do
  [[ -n $key ]] || break
  case "$key" in
    protocol) protocol=$value ;;
    host) host=$value ;;
    path) path=$value ;;
  esac
done

case "$operation" in
  get)
    [[ $protocol == https && $host == github.com ]] || exit 0
    # credential.useHttpPath is forced by the authenticated session. Require the
    # exact frozen repository path as an additional fail-closed check so a
    # command-level config override cannot reuse this token for another path.
    [[ -n $path ]] || exit 0
    normalized_path=${path%.git}
    [[ $normalized_path == "$AGENT_GITHUB_REPO_FULL_NAME" ]] || exit 0

    token=${AGENT_GITHUB_GIT_TOKEN:-}
    [[ -n $token ]] || agent_github_die 'GitHub credential requested outside the authenticated git wrapper'
    printf 'username=x-access-token\npassword=%s\n\n' "$token"
    ;;
  store|erase)
    # Git may call store before the full fetch/push object transfer finishes.
    # Token lifecycle is owned by auth-bin/git, which revokes after the entire
    # Git process exits. Do not revoke from credential-helper callbacks.
    exit 0
    ;;
  *)
    agent_github_die "unsupported git credential operation: ${operation:-<empty>}"
    ;;
esac
